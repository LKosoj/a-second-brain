[Unit]
Description=A Second Brain weekly vault backup verification

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=@PROJECT_DIR@/.env
Environment=UV_BIN=@UV_BIN@@TZ_ENVIRONMENT@
TimeoutStartSec=1h
ExecStart=@UV_BIN@ run --frozen --no-dev python -m d_brain.run_vault_backup --verify
NoNewPrivileges=true
