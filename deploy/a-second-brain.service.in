[Unit]
Description=A Second Brain Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=@PROJECT_DIR@/.env
Environment=UV_BIN=@UV_BIN@@TZ_ENVIRONMENT@
ExecStart=@UV_BIN@ run --frozen --no-dev a-second-brain run
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
# SIGTERM goes to the bot first so it can close its tmux sessions; whatever is
# left in the cgroup (tmux servers after a crash or kill -9, an ffmpeg run) is
# SIGKILLed once the main process is gone, so a restarted bot never runs next
# to an old session.
KillMode=mixed

[Install]
WantedBy=default.target
