<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.second-brain.process</string>
    <!-- launchd runs one program per plist, unlike systemd's
         ExecStartPre + ExecStart. Mirror the systemd process unit (backup,
         then the daily process) by handing the wrapper a shell command that
         runs both, in order, via the same @UV_BIN@ invocation. -->
    <key>ProgramArguments</key>
    <array>
        <string>@WRAPPER@</string>
        <string>@PROJECT_DIR@</string>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>"@UV_BIN@" run --frozen --no-dev python -m d_brain.run_vault_backup &amp;&amp; "@UV_BIN@" run --frozen --no-dev python -m d_brain.run_daily_process --mode scheduled</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>UV_BIN</key>
        <string>@UV_BIN@</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>@PROJECT_DIR@</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>21</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>@LOG_DIR@/process.out.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/process.err.log</string>
</dict>
</plist>