[Unit]
Description=A Second Brain scheduled processing

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=@PROJECT_DIR@/.env
Environment=UV_BIN=@UV_BIN@
# oneshot units have no start timeout by default; bound it so a wedged AI
# CLI cannot hang forever and block every later scheduled run.
TimeoutStartSec=4h
ExecStartPre=@UV_BIN@ run --frozen --no-dev python -m d_brain.run_vault_backup
ExecStart=@UV_BIN@ run --frozen --no-dev python -m d_brain.run_daily_process --mode scheduled
NoNewPrivileges=true
