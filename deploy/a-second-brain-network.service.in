[Unit]
Description=A Second Brain LacEditor network API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=@PROJECT_DIR@/.env
Environment=UV_BIN=@UV_BIN@@TZ_ENVIRONMENT@
ExecStart=@UV_BIN@ run --frozen --no-dev a-second-brain network
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
KillMode=mixed

[Install]
WantedBy=default.target
