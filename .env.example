# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Deepgram API key for voice transcription
DEEPGRAM_API_KEY=

# Todoist API key for task management
TODOIST_API_KEY=

# Tavily Extract API key for hard-to-read web pages
TAVILY_API_KEY=

# Jina Reader API key for browser-rendered content extraction
JINA_API_KEY=

# Z.AI Reader API key for content extraction fallback
ZAI_API_KEY=

# Optional proxy reader base URL
PROXY_URL=

# PLAUD bearer token for recording import
PLAUD_BEARER_TOKEN=

# PLAUD API region: api or api-euc1
PLAUD_REGION=api

# Full name of the assistant owner for prompt context
OWNER_FULL_NAME=

# Language for generated saved content (for example: ru, en)
CONTENT_LANGUAGE=ru

# Which CLI backend to use for processing: claude, claude-tmux, codex, qwen,
# gemini, kimi, grok, opencode
# claude-tmux drives the interactive Claude Code interface inside tmux instead
# of headless mode; it needs the tmux command.
AI_CLI=claude

# Path to Obsidian vault directory
VAULT_PATH=./vault

# Encrypted full-vault snapshot before scheduled write-heavy processing.
# Import the recipient public key on this host, but keep the private key elsewhere.
VAULT_BACKUP_DIR=./.vault-backups
VAULT_BACKUP_GPG_RECIPIENT=
VAULT_BACKUP_RETENTION=14

# Telegram user ID allowed to use the bot (replace 0 before starting)
OWNER_TELEGRAM_ID=0

# Shared OpenAI-compatible gateway settings for qmd remote models
# and the recall-planner helper used before direct question /do runs.
OPENAI_API_KEY=
BASE_URL=
MODEL=
EMB_MODEL=
RERANK_MODEL=

# Send extra_body thinking:{"type":"disabled"} on recall planner requests.
# 1 = send it (provider skips its thinking step before answering, if it
#     supports the knob — faster, cheaper);
# 0 = do not send extra_body at all, leaving thinking control to the
#     provider default.
# Honoured only when the provider exposes the knob through the
# OpenAI-compatible API.
RECALL_PLANNER_DISABLE_THINKING=0

# AnythingLLM RAG (read-only knowledge-base search)
# Instance URL without the /api suffix, e.g. https://anythingllm.example.com
ANYTHINGLLM_BASE_URL=
# Developer API key from AnythingLLM Settings -> API Keys
ANYTHINGLLM_API_KEY=
# Workspace URL slug, not the display name
ANYTHINGLLM_WORKSPACE=
